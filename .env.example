# Optional settings for pidcheck (identifier and vocabulary checks).
# Copy to .env and fill in what you need; .env is not committed.
# Real environment variables take precedence over .env.

# ROR API client ID, sent in a Client-Id header. Not required today:
# anonymous access allows 2,000 requests per 5 minutes per IP.
# https://ror.readme.io/docs/client-id
ROR_CLIENT_ID=

# ORCID public API credentials. Anonymous reads work (25,000 per day per
# IP); with credentials, a /read-public token is obtained once per run.
# Register at https://orcid.org/developer-tools
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Or give a /read-public token directly instead of the two above.
ORCID_ACCESS_TOKEN=

# Where resolver results are cached, and for how many days.
PIDCHECK_CACHE_DIR=
PIDCHECK_CACHE_DAYS=30
